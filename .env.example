# ---------- Backend (backend/.env or exported in the shell) ----------
APP_ENV=development
# SQLite by default; use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://civicflow:civicflow@localhost:5432/civicflow
DATABASE_URL=sqlite:///./civicflow.db
CORS_ORIGINS=http://localhost:5173

# auto  -> use Bedrock when AWS credentials are present, otherwise the offline policy model
# bedrock -> require Bedrock (fails fast if credentials are missing)
# local -> always use the deterministic offline policy model
MODEL_PROVIDER=auto
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
AWS_REGION=us-east-1
# AWS credentials are read by boto3 from the standard locations
# (env vars, ~/.aws/credentials, instance role). Never commit them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Background monitor (overdue detection / follow-ups) interval
MONITOR_INTERVAL_SECONDS=60
# Seed the demo organization + 4 historical requests on first start
SEED_DEMO_DATA=true

# ---------- Frontend (frontend/.env) ----------
# Leave unset in development: Vite proxies /api to http://localhost:8000
# VITE_API_URL=https://your-api.example.com/api
